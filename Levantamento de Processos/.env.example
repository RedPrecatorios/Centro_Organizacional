# Pool de IPs fixos Webshare (ip:porta:user:senha)
# Por padrão usa a lista do REFACTOR_TJSP (webshare-proxies-list.txt)
WEBSHARE_PROXIES_LIST=/mnt/volume_nyc1_1778499775066/REFACTOR_TJSP/webshare-proxies-list.txt
HTTP_PROXY_MAX_ATTEMPTS=3
# Fallback legado (só se a lista estiver vazia/ausente):
# WEBSHARE_PROXY_HOST=
# WEBSHARE_PROXY_PORT=
# WEBSHARE_PROXY_USERNAME=
# WEBSHARE_PROXY_PASSWORD=

HEADLESS=true
BROWSER_TIMEOUT_SECONDS=180
PAGE_LOAD_WAIT_SECONDS=4

# Paths
# REFACTOR_TJSP_PATH=
# FINAL_OUTPUT_DIR=
# CHROME_BINARY=

FLASK_DB_HOST=
FLASK_DB_PORT=3306
FLASK_DB_USER=
FLASK_DB_PASSWORD=
FLASK_DB_DATABASE=
PREENCHIMENTO_SQL=

GEMINI_API_KEY=
USE_GEMINI_API=true
REFACTOR_MODE=reprocessamento
REFACTOR_TEST_MODE=false
ENABLE_PERSISTENCE=true
USE_CALCULO_API=True
CALCULO_API_URL=
CALCULO_API_TOKEN=

# --- API HTTP (cloud → cloud) ---
# Local (só nesta máquina): 127.0.0.1
# Remoto atrás de nginx:    127.0.0.1 (nginx faz proxy)  OU  0.0.0.0 se sem nginx
API_HOST=127.0.0.1
API_PORT=8003

# Chave compartilhada com a plataforma (TJSP_API_KEY / TJSP_API_TOKEN).
# Preferir API_KEY; API_TOKEN continua a funcionar (legado).
API_KEY=
# API_TOKEN=

# Opcional: só aceitar a IP pública da cloud da plataforma (ou CIDR).
# API_ALLOWED_IPS=203.0.113.10
# API_TRUST_PROXY=true

# CORS só se o browser chamar a API diretamente (a plataforma usa proxy Flask).
# API_CORS_ORIGINS=https://plataforma.example.com

LOG_DIR=logs
DEBUG_HTML_DIR=logs/debug_html
