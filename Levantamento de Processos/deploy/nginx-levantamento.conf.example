# Exemplo nginx — Levantamento Processual (cloud remota)
# Coloque em /etc/nginx/sites-available/levantamento e ative com symlink.
# Substitua levantamento.example.com e caminhos do certificado.

upstream levantamento_api {
    server 127.0.0.1:8003;
    keepalive 8;
}

server {
    listen 80;
    server_name levantamento.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name levantamento.example.com;

    # ssl_certificate     /etc/letsencrypt/live/levantamento.example.com/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/levantamento.example.com/privkey.pem;
    # include /etc/letsencrypt/options-ssl-nginx.conf;

    # Só a cloud da plataforma deve chegar aqui (também reforçado com API_ALLOWED_IPS).
    # allow 203.0.113.10;   # IP público cloud A
    # deny all;

    client_max_body_size 2m;

    location /api/ {
        proxy_pass http://levantamento_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_connect_timeout 10s;
        proxy_send_timeout 120s;
        proxy_read_timeout 120s;
    }

    location / {
        return 404;
    }
}
